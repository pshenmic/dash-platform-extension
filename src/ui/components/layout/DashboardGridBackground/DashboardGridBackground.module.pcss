/* Figma "Grid (Stroke)": ~36.91px cells, fade in toward top-right */
.grid {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background-image:
    linear-gradient(to right, #0c1c33 1px, transparent 1px),
    linear-gradient(to bottom, #0c1c33 1px, transparent 1px);
  background-size: 2.307rem 2.307rem;
  background-position: top right;
  mask-image: linear-gradient(27deg, transparent 51%, #000 100%);
  -webkit-mask-image: linear-gradient(27deg, transparent 51%, #000 100%);
  opacity: 0.16;
}
