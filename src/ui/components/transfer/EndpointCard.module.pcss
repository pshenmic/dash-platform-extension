/* 1px border fading to transparent in the middle; the element needs position relative. */
.gradientBorder::before {
  content: '';
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: linear-gradient(to bottom, rgba(12, 28, 51, .08), rgba(12, 28, 51, 0) 50%, rgba(12, 28, 51, .04));
  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  pointer-events: none;
}

@media (prefers-color-scheme: dark) {
  .gradientBorder::before {
    background: linear-gradient(to bottom, rgba(255, 255, 255, .08), rgba(255, 255, 255, 0) 50%, rgba(255, 255, 255, .04));
  }
}
